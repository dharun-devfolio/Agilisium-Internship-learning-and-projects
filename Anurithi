CREATE database agil_db;
USE agil_db;
CREATE table dept(
    dept_id int primary key,
    dept_name varchar(50),
    location varchar(50)
);
CREATE table emp(
    emp_id int primary key,
    first_name varchar(50),
    last_name varchar(50),
    dept_id int,
    salary decimal(10,2),
    hire_date date;
    foreing key(dept_id),
    references dept(dept_id)
);
