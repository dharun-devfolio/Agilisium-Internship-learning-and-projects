-- emp name, job title and dept using inner join
select e.employee_name, e.job_title, d.department_name
from employee e
inner join department d
on e.dept_id=d.department_id;

-- employees with manager name
select e.employee_name as emp, m.employee_name as manager
from employee e
join employee m
on e.manager_id=m.employee_id;

-- all dept with employee count
select d.department_name, count(employee_id)
from department d
left join employee e
on d.department_id=e.dept_id
group by department_name;

-- all dept with employee count
select d.department_name, e.employee_name
from department d
right join employee e
on d.department_id=e.dept_id

-- empl earning more than avg salary
use agil_data;
select employee_name, salary 
from employee
where salary>(
select avg(salary)
from employee
);

-- employees earning more than their manager's salary
select e.employee_name, e.salary, m.employee_name as manager_name, m.salary as manager_salary
from employee e
inner join employee m
on e.manager_id=m.employee_id
where e.salary>m.salary;

-- dept earning more than 200000
select d.department_id, d.department_name, SUM(e.salary) AS total_salary
from department d
inner join employee e
on d.department_id = e.dept_id
group by d.department_id, d.department_name
having sum(e.salary) > 200000;

-- get all job titles from emplyee and managers using union
select e.job_title
from employee e
union
select m.job_title
from employee e
inner join employee m
on e.manager_id=m.employee_id;

